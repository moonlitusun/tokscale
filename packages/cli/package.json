{
  "name": "tokenusage-cli",
  "version": "4.5.3",
  "description": "A high-performance CLI tool and visualization dashboard for tracking AI coding assistant token usage and costs across multiple platforms.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "tu": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist/**/*"
  ],
  "publishConfig": {
    "registry": "http://npm.dzfe.net/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junhoyeo/tokenusage.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {},
  "optionalDependencies": {
    "tokenusage-cli-darwin-arm64": "4.5.3",
    "tokenusage-cli-darwin-x64": "4.5.3",
    "tokenusage-cli-linux-x64-gnu": "4.5.3",
    "tokenusage-cli-linux-x64-musl": "4.5.3",
    "tokenusage-cli-linux-arm64-gnu": "4.5.3",
    "tokenusage-cli-linux-arm64-musl": "4.5.3",
    "tokenusage-cli-win32-x64-msvc": "4.5.3",
    "tokenusage-cli-win32-arm64-msvc": "4.5.3",
    "tokenusage-cli-android-arm64": "4.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "tokenusage",
    "opencode",
    "claude-code",
    "cursor",
    "gemini",
    "codex",
    "fx",
    "omp",
    "cli"
  ]
}
